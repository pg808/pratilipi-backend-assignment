// graphql-gateway/index.js
const { ApolloServer, gql } = require('apollo-server');
const fetch = require('node-fetch');
const jwt = require('jsonwebtoken');

const typeDefs = gql`
  type User {
    id: ID
    name: String
    email: String
    preferences: String
  }

  type Notification {
    id: ID
    userId: ID
    type: String
    content: String
    sentAt: String
    read: Boolean
  }

  type Recommendation {
    userId: ID
    content: String
  }

  type Query {
    me(token: String!): User
    unreadNotifications(userId: ID!): [Notification]
  }

  type Mutation {
    markNotificationRead(notificationId: ID!): String
    generateRecommendations(userId: ID!): Recommendation
  }
`;

const resolvers = {
  Query: {
    me: async (_, { token }) => {
      const decoded = jwt.verify(token, process.env.JWT_SECRET);
      const res = await fetch(`http://user-service:${process.env.USER_PORT}/me`, {
        headers: { Authorization: `Bearer ${token}` },
      });
      return res.json();
    },
    unreadNotifications: async (_, { userId }) => {
      const res = await fetch(`http://notification-service:${process.env.NOTIF_PORT}/unread/${userId}`);
      return res.json();
    },
  },
  Mutation: {
    markNotificationRead: async (_, { notificationId }) => {
      await fetch(`http://notification-service:${process.env.NOTIF_PORT}/mark-read`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ notificationId }),
      });
      return 'Marked as read';
    },
    generateRecommendations: async (_, { userId }) => {
      const res = await fetch(`http://recommendation-service:${process.env.REC_PORT}/generate/${userId}`, {
        method: 'POST',
      });
      return res.json();
    },
  },
};

const server = new ApolloServer({ typeDefs, resolvers });

server.listen().then(({ url }) => {
  console.log(`GraphQL Gateway ready at ${url}`);
});
