// user-service/index.js
const express = require('express');
const bodyParser = require('body-parser');
const jwt = require('jsonwebtoken');
const amqp = require('amqplib');
const { Pool } = require('pg');
const app = express();

app.use(bodyParser.json());

const pool = new Pool({
  host: process.env.DB_HOST,
  user: process.env.DB_USER,
  password: process.env.DB_PASS,
  database: process.env.DB_NAME,
});

let channel;
(async () => {
  const conn = await amqp.connect(process.env.RABBITMQ_URL);
  channel = await conn.createChannel();
  await channel.assertQueue('user.events');
})();

app.post('/register', async (req, res) => {
  const { name, email, preferences } = req.body;
  const { rows } = await pool.query('INSERT INTO users(name, email, preferences) VALUES ($1, $2, $3) RETURNING *', [name, email, preferences]);
  const user = rows[0];
  channel.sendToQueue('user.events', Buffer.from(JSON.stringify({ type: 'USER_REGISTERED', payload: user })));
  res.json(user);
});

app.use((req, res, next) => {
  const token = req.headers['authorization']?.split(' ')[1];
  if (!token) return res.status(401).send('Missing token');
  try {
    req.user = jwt.verify(token, process.env.JWT_SECRET);
    next();
  } catch (err) {
    res.status(403).send('Invalid token');
  }
});

app.get('/me', async (req, res) => {
  const { rows } = await pool.query('SELECT * FROM users WHERE id = $1', [req.user.id]);
  res.json(rows[0]);
});

app.listen(process.env.PORT, () => console.log(`User Service running on ${process.env.PORT}`));


// notification-service/index.js
const express = require('express');
const bodyParser = require('body-parser');
const { Pool } = require('pg');
const amqp = require('amqplib');
const app = express();

app.use(bodyParser.json());

const pool = new Pool({
  host: process.env.DB_HOST,
  user: process.env.DB_USER,
  password: process.env.DB_PASS,
  database: process.env.DB_NAME,
});

let channel;
(async () => {
  const conn = await amqp.connect(process.env.RABBITMQ_URL);
  channel = await conn.createChannel();
  await channel.assertQueue('notification.events');
})();

app.post('/mark-read', async (req, res) => {
  const { notificationId } = req.body;
  await pool.query('UPDATE notifications SET read = true WHERE id = $1', [notificationId]);
  res.send('Marked as read');
});

app.get('/unread/:userId', async (req, res) => {
  const { rows } = await pool.query('SELECT * FROM notifications WHERE userId = $1 AND read = false', [req.params.userId]);
  res.json(rows);
});

app.listen(process.env.PORT, () => console.log(`Notification Service running on ${process.env.PORT}`));


